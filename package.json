{
  "name": "rwa-tokenisation",
  "version": "1.0.0",
  "description": "Tokenisation of real-world and digital assets on Ethereum — SC4053 NTU",
  "type": "module",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:ephemeral": "hardhat run scripts/deploy.ts --network hardhatMainnet",
    "frontend:sync": "hardhat compile && node scripts/syncFrontend.mjs",
    "demo:local": "hardhat run scripts/seedLocal.ts --network localhost",
    "test:integration": "npm --prefix frontend run test:integration",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityamd1307/Tokenisation-Using-BlockChain.git"
  },
  "keywords": [],
  "author": "Chordia Laksh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/adityamd1307/Tokenisation-Using-BlockChain/issues"
  },
  "homepage": "https://github.com/adityamd1307/Tokenisation-Using-BlockChain#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "hardhat": "^3.21.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
