# Names that hardhat.config.ts reads with configVariable (Phase 5 decision D12).
# Nothing loads a .env file automatically. Prefer Hardhat's encrypted keystore:
#   npx hardhat keystore set TESTNET_RPC_URL
#   npx hardhat keystore set SEPOLIA_KEY_A   (and B, C, D)
# or set them as environment variables in your own terminal for one session.
# Use throwaway testnet wallets that have never held real funds.
# Never paste these values into any AI tool: transcripts are committed to git.
TESTNET_RPC_URL=
# Wallet A: platform administrator and deployer
SEPOLIA_KEY_A=
# Wallet B: authorised issuer
SEPOLIA_KEY_B=
# Wallet C: approved investor
SEPOLIA_KEY_C=
# Wallet D: initially unapproved investor
SEPOLIA_KEY_D=
# Not used in Phase 5 (no Etherscan verification step)
ETHERSCAN_API_KEY=
