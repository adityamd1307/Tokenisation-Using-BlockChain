{
  "name": "rwa-tokenisation-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/syncFrontend.mjs",
    "dev": "vite",
    "prebuild": "node ../scripts/syncFrontend.mjs",
