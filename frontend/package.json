    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
